/dts-v1/;

#include <ti/mspm33/mspm33c321a.dtsi>
#include <ti/mspm33/mspm33c321a-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	model = "TI LP_MSPM33C321A/MSPM33C321A";
	compatible = "ti,mspm33c321a";

	aliases {
		led0 = &led0;
		led1 = &led1;
		led2 = &led2;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	leds {
    		compatible = "gpio-leds";

    		led0: led_0 {
      			gpios = <&gpioc 26 GPIO_ACTIVE_HIGH>;
      			label = "Red LED";
   		};

		led1: led_1 {
			gpios = <&gpioc 27 GPIO_ACTIVE_HIGH>;
			label = "Green LED";
		};

		led2: led_2 {
			gpios = <&gpioa 2 GPIO_ACTIVE_HIGH>;
			label = "Blue LED";
		};
  	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(160)>;
};

&pinctrl {
	status = "okay";
};

&sram0 {
	status = "okay";
};

&flash0 {
	status = "okay";
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&gpioc {
	status = "okay";
};
