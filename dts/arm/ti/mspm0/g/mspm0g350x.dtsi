#include <ti/mspm0/g/mspm0g.dtsi>
#include <zephyr/dt-bindings/i2c/i2c.h>

/delete-node/ &sram0;

/ {
	soc {
		i2c0: i2c@400f0000 {
			compatible = "ti,mspm0-i2c";
			clocks = <&ckm MSPM0_CLOCK_ULPCLK>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x400f0000 0x2000>;
			interrupts = <24 0>;
			status = "disabled";
		};

		i2c1: i2c@400f2000 {
			compatible = "ti,mspm0-i2c";
			clocks = <&ckm MSPM0_CLOCK_ULPCLK>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x400f2000 0x2000>;
			interrupts = <25 0>;
			status = "disabled";
		};
