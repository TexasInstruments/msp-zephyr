 *
 * Board overlay for timer-triggered ADC sample on LP_MSPM33C321A.
 * Configures TIMG8_0 and ADC0 connected via event fabric channel 1.
 */

#include <zephyr/dt-bindings/adc/adc.h>

/ {
	zephyr,user {
		io-channels = <&adc0 0>;
	};
};

/*
 * Timer Configuration (Event Publisher)
 * - Clocked from MCLKBY2 (80 MHz) with prescaler 80 -> 1 MHz timer clock
 * - Configured by application for 1 kHz (1 ms) periodic triggering
 * - Publishes ti,timer-event-type events on event channel 1
 *
 * Available timer event types (ti,timer-event-type):
 *   0 = ZERO_EVENT  - Counter reaches zero (default, most common)
 *   1 = LOAD_EVENT  - Counter loaded with initial value
 *   2 = CC0_DN      - Capture/Compare 0 match (down counting)
 *   3 = CC0_UP      - Capture/Compare 0 match (up counting)
 *   4 = CC1_DN      - Capture/Compare 1 match (down counting)
 *   5 = CC1_UP      - Capture/Compare 1 match (up counting)
 */
&timg8_0 {
	status = "okay";
	ti,clk-prescaler = <79>;
	ti,timer-event-type = <0>;  /* ZERO_EVENT */
};

&counterg8_0 {
	status = "okay";
};

/*
 * ADC Configuration (Event Subscriber)
 * - Hardware-triggered via GEN_SUB_0 subscribed to event channel 1
 * - Channel 0 on PA27, 12-bit, VDDA reference (3.3V)
 */
&adc0 {
	status = "okay";

	ti,hw-trigger-enable;
	ti,hw-trigger-source = <0>;        /* GEN_SUB_0 */
	ti,hw-trigger-event-channel = <1>; /* Event channel 1 */

	ti,clk-divider = <2>;
	ti,vref-source = <0>;  /* VDDA */
	vref-mv = <3300>;

	pinctrl-0 = <&analog_pa27>;
	pinctrl-names = "default";

	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 200)>;
		zephyr,resolution = <12>;
		zephyr,vref-mv = <3300>;
	};
};

/*
 * Event Fabric Connection:
 * TIMG8_0 (timer event) -> Event Channel 1 -> HSADC GEN_SUB_0 (triggers ADC)
 *
 * Important: Event channel numbers must match between publisher and subscriber!
 */
