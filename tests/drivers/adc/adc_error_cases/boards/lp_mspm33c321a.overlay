/ {
	zephyr,user {
		io-channels = <&adc0 0>;
	};

	aliases {
		adc = &adc0;
	};
};

&adc0 {
	status = "okay";
	ti,clk-divider = <2>;
	ti,vref-source = <0>;  /* VDDA (3.3V) */
	pinctrl-0 = <&analog_pa27>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 200)>;
		zephyr,resolution = <12>;
		zephyr,vref-mv = <3300>;
	};
};
